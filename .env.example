# LLM-Based Research Gap Identification and Experiment Planning (quantum physics)
# Copy this file to .env and fill in your own values. Never commit .env.
# Without a working LLM, analysis falls back to rule-based extraction and is labelled as such.

# --- LLM: Gemini API (Google AI Studio key) is the primary provider -----------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when GEMINI_MODEL is overloaded (503) or rate-limited (429)
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest,gemini-3.1-flash-lite
# Seconds an overloaded model is skipped before being tried again
GEMINI_COOLDOWN_SECONDS=300

# --- Optional: Google Cloud Vertex AI (set LLM_PROVIDER=vertex; needs billing) -------
GOOGLE_APPLICATION_CREDENTIALS=path/to/vertex-service-account.json
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.8-flash

# --- Optional: other LLM providers (set LLM_PROVIDER=openai or anthropic; none = rule-based only) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# --- Knowledge base -----------------------------------------------------------------
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=./chroma_db
# 1 = refuse to start if semantic retrieval (ChromaDB + embeddings) is unavailable
KB_REQUIRE_SEMANTIC=0

# --- Research database (publications, searches, gaps, approvals, LLM call log) -------
RESEARCH_DB_URL=sqlite:///data/research.db
# 0 disables the llm_calls audit log
LLM_CALL_LOGGING=1
# Guided-run checkpoints (a run resumes from here after a restart)
# RESEARCH_CHECKPOINTS=data/checkpoints.db
# Scholarly API response cache
# LITERATURE_CACHE_DIR=data/cache/http

# --- Scholarly APIs (used from Phase 2) ----------------------------------------------
# Free key from https://openalex.org/settings/api (keyless requests share a small daily budget)
OPENALEX_API_KEY=
# Optional: address for Crossref's polite pool
CROSSREF_MAILTO=
# Optional: Semantic Scholar API key (keyless requests are frequently rate-limited)
SEMANTIC_SCHOLAR_API_KEY=
